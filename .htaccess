# Alles-Atlas.de – Apache-Konfiguration
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On

# HTTPS und ohne www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://alles-atlas.de%{REQUEST_URI} [L,R=301]

# Alte WordPress-Adressen dauerhaft auf die neuen Seiten umleiten
RewriteCond %{QUERY_STRING} (^|&)page_id=17(&|$)
RewriteRule ^(index\.php)?$ /service/? [L,R=301]
RewriteCond %{QUERY_STRING} (^|&)page_id=7(&|$)
RewriteRule ^(index\.php)?$ /kontakt/? [L,R=301]
RewriteCond %{QUERY_STRING} (^|&)page_id=14(&|$)
RewriteRule ^(index\.php)?$ /impressum/? [L,R=301]
RewriteCond %{QUERY_STRING} (^|&)page_id=702(&|$)
RewriteRule ^(index\.php)?$ /dsgvo/? [L,R=301]
RewriteCond %{QUERY_STRING} (^|&)(p=1|cat=5|author=3|attachment_id=\d+|feed=.*)(&|$)
RewriteRule ^(index\.php)?$ /? [L,R=301]
RewriteRule ^(wp-login\.php|wp-admin/?.*|xmlrpc\.php)$ - [G]
</IfModule>

# Bausteine nicht ausliefern
RedirectMatch 404 ^/(src|tools|\.git)(/|$)
RedirectMatch 404 ^/README\.md$

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType text/css "access plus 1 week"
ExpiresByType application/javascript "access plus 1 week"
</IfModule>

AddType font/woff2 .woff2
AddType text/vcard .vcf
